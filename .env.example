# 公開URL（sitemap・canonical・OGPに使用）
NEXT_PUBLIC_SITE_URL=https://example.com

# 「一食分の食べ比べセット」予約受付フォーム（Googleフォーム等）。空なら非表示
NEXT_PUBLIC_WAITLIST_URL=

# Kindle本のAmazon商品ページURL（出版後に設定）。空なら非表示
NEXT_PUBLIC_EBOOK_URL=

# Google AdSense のパブリッシャーID（審査通過後に設定）
NEXT_PUBLIC_ADSENSE_CLIENT=

# ASPで発行したアフィリエイトリンク（空の案件は非表示）
NEXT_PUBLIC_AFF_STARTER_SET=
NEXT_PUBLIC_AFF_MINI_BOTTLES=
NEXT_PUBLIC_AFF_KIOKE=
NEXT_PUBLIC_AFF_DASHI=
